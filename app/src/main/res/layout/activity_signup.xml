<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- 앱 제목 / 로고 대체 텍스트 -->
        <TextView
            android:id="@+id/tv_signup_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="회원가입"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="40dp" />

        <TextView
            android:id="@+id/tv_signup_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="인드랍쉬핑 계정을 만들어 시작해보세요"
            android:textSize="12sp"
            android:layout_marginTop="8dp"
            android:textColor="#666666" />

        <!-- 간격 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <!-- 닉네임 입력 -->
        <EditText
            android:id="@+id/et_nickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="닉네임"
            android:inputType="textPersonName" />

        <!-- 이메일 입력 -->
        <EditText
            android:id="@+id/et_signup_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="이메일"
            android:inputType="textEmailAddress"
            android:layout_marginTop="12dp" />

        <!-- 비밀번호 입력 -->
        <EditText
            android:id="@+id/et_signup_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="비밀번호 (6자 이상)"
            android:inputType="textPassword"
            android:layout_marginTop="12dp" />

        <!-- 비밀번호 확인 -->
        <EditText
            android:id="@+id/et_signup_password_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="비밀번호 확인"
            android:inputType="textPassword"
            android:layout_marginTop="12dp" />

        <!-- 회원가입 버튼 -->
        <Button
            android:id="@+id/btn_signup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="회원가입 완료"
            android:backgroundTint="#009688"
            android:layout_marginTop="20dp" />

        <!-- 에러 메시지 -->
        <TextView
            android:id="@+id/tv_signup_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF4444"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_marginTop="8dp" />

        <!-- 구분선 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginTop="24dp" />

        <!-- 로그인으로 돌아가기 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이미 계정이 있나요? " />

            <TextView
                android:id="@+id/tv_go_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="로그인"
                android:textStyle="bold"
                android:textColor="#2979FF" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
    <!-- === 여기까지 복붙: activity_signup.xml === -->
