<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="12dp">
    <TextView android:id="@+id/tv_post_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="제목" android:textStyle="bold"/>
    <TextView android:id="@+id/tv_post_price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="가격"/>
    <TextView android:id="@+id/tv_post_desc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="설명" android:visibility="gone"/>
</LinearLayout>