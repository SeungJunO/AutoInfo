<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 전체 세로 스크롤 가능한 영역 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1) 상단 타이틀 + 검색 버튼 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_market_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Auto Info"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_search"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:src="@android:drawable/ic_menu_search"
                    android:contentDescription="검색" />
            </LinearLayout>

            <!-- 간단한 설명 텍스트 -->
            <TextView
                android:id="@+id/tv_market_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="원하는 정보를 검색하거나, 인기 인포를 둘러보세요."
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginTop="4dp" />

            <!-- 2) 카테고리 가로 스크롤 -->
            <TextView
                android:id="@+id/tv_category_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="카테고리"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:textSize="16sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layout_categories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- 나중에 동적으로 Chip/버튼 추가해도 됨. 지금은 예시 버튼들 -->
                    <Button
                        android:id="@+id/btn_cat_marketing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="마케팅"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btn_cat_money"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="재테크"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btn_cat_study"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="공부법"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btn_cat_sns"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SNS"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btn_cat_etc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="기타" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 3) 인기 인포 섹션 제목 -->
            <TextView
                android:id="@+id/tv_popular_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔥 인기 인포"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp" />

            <!-- 인기 인포 가로 리사이클러뷰 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_popular_posts"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="8dp"
                android:overScrollMode="never" />

            <!-- 4) 최신 인포 섹션 제목 -->
            <TextView
                android:id="@+id/tv_latest_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🆕 최신 인포"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp" />

            <!-- 최신 인포 세로 리사이클러뷰 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_latest_posts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </ScrollView>

    <!-- 5) 새 인포 등록 Floating Action Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_post"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="새 인포 등록"
        app:srcCompat="@android:drawable/ic_input_add"
        app:layout_anchorGravity="bottom|end"
        android:layout_gravity="bottom|end" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
    <!-- === 여기까지 복붙 === -->

