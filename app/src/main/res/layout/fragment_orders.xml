<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="주문 (즉시 결제)"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="주문 정보를 입력하면 바로 Shopify 결제로 이동합니다"
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginTop="6dp" />

        <EditText
            android:id="@+id/et_variant_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Shopify Variant ID (gid://shopify/ProductVariant/...)"
            android:layout_marginTop="16dp"
            android:inputType="text" />

        <EditText
            android:id="@+id/et_quantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="수량"
            android:inputType="number"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/et_customer_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="구매자 이름"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/et_customer_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="구매자 이메일"
            android:inputType="textEmailAddress"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btn_pay_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="결제하러 가기"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#666666"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
