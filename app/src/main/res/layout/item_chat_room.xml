<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:padding="8dp">

    <!-- 왼쪽 원형 프로필(대충 색 있는 동그라미) -->
    <View
        android:id="@+id/view_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/darker_gray"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- 상대 이름 / 채팅방 제목 -->
    <TextView
        android:id="@+id/tv_chat_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="상대 이름 또는 채팅방 이름"
        android:textSize="16sp"
        android:textStyle="bold"
        android:ellipsize="end"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/view_avatar"
        app:layout_constraintTop_toTopOf="@id/view_avatar"
        app:layout_constraintEnd_toStartOf="@id/tv_chat_time" />

    <!-- 마지막 메시지 -->
    <TextView
        android:id="@+id/tv_chat_last_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="마지막 메시지 미리보기 내용입니다."
        android:textSize="13sp"
        android:textColor="#666666"
        android:ellipsize="end"
        android:maxLines="1"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toStartOf="@id/tv_chat_title"
        app:layout_constraintTop_toBottomOf="@id/tv_chat_title"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 오른쪽 상단에 시간 표시 -->
    <TextView
        android:id="@+id/tv_chat_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="오후 3:20"
        android:textSize="11sp"
        android:textColor="#999999"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_chat_title" />

</androidx.constraintlayout.widget.ConstraintLayout>
    <!-- === 여기까지 복붙: item_chat_room.xml === -->
