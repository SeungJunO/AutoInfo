<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 상단 + 리스트 전체를 감싸는 레이아웃 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1) 상단 타이틀 -->
        <TextView
            android:id="@+id/tv_chat_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="채팅"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- 서브 텍스트 -->
        <TextView
            android:id="@+id/tv_chat_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="구매자/판매자와 나눈 대화가 여기에 표시됩니다."
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginTop="4dp" />

        <!-- 구분선 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#DDDDDD" />

        <!-- 2) 채팅방 목록 RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_chat_rooms"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1" />

        <!-- 3) 채팅방이 없는 경우 보여줄 텍스트 (초기엔 숨김) -->
        <TextView
            android:id="@+id/tv_chat_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="아직 대화 중인 채팅방이 없습니다."
            android:textSize="13sp"
            android:textColor="#999999"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
